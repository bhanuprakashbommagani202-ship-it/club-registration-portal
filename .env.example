# Copy this file to ".env" (same folder) and fill it in. ".env" is never committed.
# Your Docker Hub username (lowercase) - used to name and push the images.
DOCKERHUB_USER=your-dockerhub-username
# MySQL root password used inside Docker
DB_PASSWORD=rootpass
# Any random string of 32+ characters
JWT_SECRET=replace-with-a-long-random-string-0123456789
